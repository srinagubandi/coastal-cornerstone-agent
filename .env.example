# Variables are read from the process environment. This service does NOT load .env files.
PORT=3000
DATA_DIR=/data
FAQ_PATH=/app/data/faq.json
REPORT_PATH=/app/data/report.json
PUBLIC_ORIGIN=https://coastal-cornerstone-agent-production.up.railway.app
OPENROUTER_MODEL=deepseek/deepseek-v4-flash
OPENROUTER_API_KEY=
# USD per token. Ceilings can only be lowered; model cap is hard-coded $1/month.
INPUT_PRICE_CEILING=0.000000091
OUTPUT_PRICE_CEILING=0.000000182
REQUEST_PRICE_CEILING=0
# Keep inactive until explicit owner approval. No startup/request test email.
DIGEST_ENABLED=false
DIGEST_FROM=notifications@propeldock.com
DIGEST_TO=ben@cccbuild.com
RESEND_API_KEY=
# Strong one-way password hash only. See docs/configuration.md and hash_password.py.
ADMIN_PASSWORD_HASH=
# Keys and random IP salt are generated privately in persistent /data/state.sqlite3.
COOKIE_SECURE=true
# Enable ONLY after verifying Railway overwrites X-Forwarded-For and origin is not directly accessible.
TRUST_PROXY=false
